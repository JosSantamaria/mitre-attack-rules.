# ============================================================================
# 90-collection-exfil.rules - Collection and Exfiltration
# ============================================================================
# Framework: MITRE ATT&CK TA0009 (Collection), TA0010 (Exfiltration), TA0011 (C2)
# Techniques: T1105, T1560, T1041, T1071
# Compatible: SUSE SLES 12+, SLES 15+, openSUSE Leap 15.x
# ============================================================================

# --- T1105 - Ingress Tool Transfer ---
-w /usr/bin/wget -p x -k MITRE:CommandAndControl:T1105:Wget
-w /usr/bin/curl -p x -k MITRE:CommandAndControl:T1105:Curl
-w /usr/bin/ftp -p x -k MITRE:CommandAndControl:T1105:FTP
-w /usr/bin/tftp -p x -k MITRE:CommandAndControl:T1105:TFTP
-w /usr/bin/rsync -p x -k MITRE:CommandAndControl:T1105:Rsync

# --- T1027 - Obfuscated Files or Information ---
-w /usr/bin/base64 -p x -k MITRE:DefenseEvasion:T1027:Base64
-w /usr/bin/xxd -p x -k MITRE:DefenseEvasion:T1027:Xxd
-w /usr/bin/od -p x -k MITRE:DefenseEvasion:T1027:Od

# --- T1560 - Archive Collected Data ---
-w /usr/bin/zip -p x -k MITRE:Collection:T1560:Zip
-w /usr/bin/gzip -p x -k MITRE:Collection:T1560:Gzip
-w /usr/bin/tar -p x -k MITRE:Collection:T1560:Tar
-w /usr/bin/bzip2 -p x -k MITRE:Collection:T1560:Bzip2
-w /usr/bin/xz -p x -k MITRE:Collection:T1560:Xz
-w /usr/bin/7z -p x -k MITRE:Collection:T1560:7z
-w /usr/bin/7za -p x -k MITRE:Collection:T1560:7za
-w /usr/bin/rar -p x -k MITRE:Collection:T1560:Rar
-w /usr/bin/unrar -p x -k MITRE:Collection:T1560:Unrar
-w /usr/bin/zstd -p x -k MITRE:Collection:T1560:Zstd

# --- T1071 - Application Layer Protocol ---
# Netcat variants for C2
-w /bin/nc -p x -k MITRE:CommandAndControl:T1071:Netcat
-w /usr/bin/nc -p x -k MITRE:CommandAndControl:T1071:Netcat
-w /bin/netcat -p x -k MITRE:CommandAndControl:T1071:Netcat
-w /usr/bin/netcat -p x -k MITRE:CommandAndControl:T1071:Netcat
-w /usr/bin/ncat -p x -k MITRE:CommandAndControl:T1071:Ncat
-w /usr/bin/socat -p x -k MITRE:CommandAndControl:T1071:Socat
