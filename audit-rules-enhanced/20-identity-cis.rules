# ============================================================================
# 20-identity-cis.rules - Identity and Account Management
# ============================================================================
# Framework: CIS Benchmark 4.1.x, MITRE ATT&CK T1136, T1098, T1087
# Compatible: SUSE SLES 12+, SLES 15+, openSUSE Leap 15.x
# ============================================================================

# --- User/Group Database Files (CIS 4.1.3) ---
# T1087.001 - Account Discovery: Local Account
-w /etc/passwd -p wa -k CIS:Identity:4.1.3:passwd
-w /etc/shadow -p wa -k CIS:Identity:4.1.3:shadow
-w /etc/group -p wa -k CIS:Identity:4.1.3:group
-w /etc/gshadow -p wa -k CIS:Identity:4.1.3:gshadow
-w /etc/security/opasswd -p wa -k CIS:Identity:4.1.3:opasswd

# --- User/Group Management Tools ---
# T1136.001 - Create Account: Local Account
-w /usr/sbin/useradd -p x -k MITRE:Persistence:T1136.001:UserAdd
-w /usr/sbin/userdel -p x -k MITRE:Persistence:T1136.001:UserDel
-w /usr/sbin/usermod -p x -k MITRE:Persistence:T1098:UserMod
-w /usr/sbin/adduser -p x -k MITRE:Persistence:T1136.001:AddUser

# T1136.001 - Group Management
-w /usr/sbin/groupadd -p x -k MITRE:Persistence:T1136.001:GroupAdd
-w /usr/sbin/groupdel -p x -k MITRE:Persistence:T1136.001:GroupDel
-w /usr/sbin/groupmod -p x -k MITRE:Persistence:T1098:GroupMod
-w /usr/sbin/addgroup -p x -k MITRE:Persistence:T1136.001:AddGroup

# --- Password Changes ---
-w /usr/bin/passwd -p x -k MITRE:Persistence:T1098:PasswdChange
-w /usr/bin/chpasswd -p x -k MITRE:Persistence:T1098:ChPasswd
-w /usr/sbin/chpasswd -p x -k MITRE:Persistence:T1098:ChPasswd
