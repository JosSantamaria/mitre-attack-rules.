# ============================================================================
# 60-credential-access.rules - Credential Access Detection
# ============================================================================
# Framework: MITRE ATT&CK TA0006 (Credential Access)
# Techniques: T1552, T1003, T1555
# Compatible: SUSE SLES 12+, SLES 15+, openSUSE Leap 15.x
# ============================================================================

# --- T1552.001 - Unsecured Credentials: Credentials In Files ---
# SSH configuration and keys
-w /etc/ssh/sshd_config -p wa -k MITRE:CredentialAccess:T1552.001:SSHConfig
-w /etc/ssh/sshd_config.d/ -p wa -k MITRE:CredentialAccess:T1552.001:SSHConfigD
-w /etc/ssh/ssh_config -p wa -k MITRE:CredentialAccess:T1552.001:SSHClientConfig
-w /etc/ssh/ssh_host_rsa_key -p r -k MITRE:CredentialAccess:T1552.004:SSHHostKey
-w /etc/ssh/ssh_host_dsa_key -p r -k MITRE:CredentialAccess:T1552.004:SSHHostKey
-w /etc/ssh/ssh_host_ecdsa_key -p r -k MITRE:CredentialAccess:T1552.004:SSHHostKey
-w /etc/ssh/ssh_host_ed25519_key -p r -k MITRE:CredentialAccess:T1552.004:SSHHostKey

# --- T1552.003 - Unsecured Credentials: Bash History ---
# Already covered in defense-evasion, but also credential access
-w /root/.bash_history -p r -k MITRE:CredentialAccess:T1552.003:BashHistoryRead

# --- T1003.008 - OS Credential Dumping: /etc/passwd and /etc/shadow ---
-w /etc/passwd -p r -k MITRE:CredentialAccess:T1003.008:PasswdRead
-w /etc/shadow -p r -k MITRE:CredentialAccess:T1003.008:ShadowRead

# --- T1555 - Credentials from Password Stores ---
# GNOME Keyring
-w /usr/bin/gnome-keyring-daemon -p x -k MITRE:CredentialAccess:T1555:GnomeKeyring

# KWallet
-w /usr/bin/kwalletd5 -p x -k MITRE:CredentialAccess:T1555:KWallet
