# ============================================================================
# 40-persistence-mitre.rules - Persistence Mechanisms
# ============================================================================
# Framework: MITRE ATT&CK TA0003 (Persistence)
# Techniques: T1053, T1546, T1543, T1547
# Compatible: SUSE SLES 12+, SLES 15+, openSUSE Leap 15.x
# ============================================================================

# --- T1053.003 - Scheduled Task/Job: Cron ---
-w /etc/crontab -p wa -k MITRE:Persistence:T1053.003:Crontab
-w /etc/cron.d/ -p wa -k MITRE:Persistence:T1053.003:CronD
-w /etc/cron.daily/ -p wa -k MITRE:Persistence:T1053.003:CronDaily
-w /etc/cron.hourly/ -p wa -k MITRE:Persistence:T1053.003:CronHourly
-w /etc/cron.weekly/ -p wa -k MITRE:Persistence:T1053.003:CronWeekly
-w /etc/cron.monthly/ -p wa -k MITRE:Persistence:T1053.003:CronMonthly
-w /etc/cron.allow -p wa -k MITRE:Persistence:T1053.003:CronAllow
-w /etc/cron.deny -p wa -k MITRE:Persistence:T1053.003:CronDeny
-w /var/spool/cron/ -p wa -k MITRE:Persistence:T1053.003:CronSpool
-w /var/spool/cron/tabs/ -p wa -k MITRE:Persistence:T1053.003:CronTabs

# Crontab command execution
-w /usr/bin/crontab -p x -k MITRE:Persistence:T1053.003:CrontabExec

# --- T1053.006 - Scheduled Task/Job: Systemd Timers ---
# Note: Wildcards not supported - monitor directories instead
-w /etc/systemd/system/ -p wa -k MITRE:Persistence:T1053.006:SystemdTimer
-w /usr/lib/systemd/system/ -p wa -k MITRE:Persistence:T1053.006:SystemdTimer

# --- T1053.002 - Scheduled Task/Job: At ---
-w /etc/at.allow -p wa -k MITRE:Persistence:T1053.002:AtAllow
-w /etc/at.deny -p wa -k MITRE:Persistence:T1053.002:AtDeny
# Note: /var/spool/atjobs/ may not exist if at is not installed
# -w /var/spool/atjobs/ -p wa -k MITRE:Persistence:T1053.002:AtJobs
-w /var/spool/at/ -p wa -k MITRE:Persistence:T1053.002:AtJobs
-w /usr/bin/at -p x -k MITRE:Persistence:T1053.002:AtExec
-w /usr/bin/atq -p x -k MITRE:Persistence:T1053.002:AtqExec
-w /usr/bin/atrm -p x -k MITRE:Persistence:T1053.002:AtrmExec
-w /usr/bin/batch -p x -k MITRE:Persistence:T1053.002:BatchExec
