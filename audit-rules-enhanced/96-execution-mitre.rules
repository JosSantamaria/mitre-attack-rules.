# ============================================================================
# 96-execution-mitre.rules - Command and Scripting Interpreter
# ============================================================================
# Framework: MITRE ATT&CK T1059 (Command and Scripting Interpreter)
# Compatible: SUSE SLES 12+, SLES 15+, openSUSE Leap 15.x
# ============================================================================

# --- T1059.004 - Unix Shell ---
# Common shells (high volume - enable selectively)
-w /bin/bash -p x -k MITRE:Execution:T1059.004:Bash
-w /usr/bin/bash -p x -k MITRE:Execution:T1059.004:Bash
-w /bin/sh -p x -k MITRE:Execution:T1059.004:Sh
-w /bin/dash -p x -k MITRE:Execution:T1059.004:Dash
-w /bin/zsh -p x -k MITRE:Execution:T1059.004:Zsh
-w /usr/bin/zsh -p x -k MITRE:Execution:T1059.004:Zsh
-w /bin/ksh -p x -k MITRE:Execution:T1059.004:Ksh
-w /usr/bin/ksh -p x -k MITRE:Execution:T1059.004:Ksh

# Suspicious/uncommon shells
-w /bin/csh -p x -k MITRE:Execution:T1059.004:Csh
-w /bin/tcsh -p x -k MITRE:Execution:T1059.004:Tcsh
-w /bin/fish -p x -k MITRE:Execution:T1059.004:Fish
-w /usr/bin/fish -p x -k MITRE:Execution:T1059.004:Fish
-w /bin/ash -p x -k MITRE:Execution:T1059.004:Ash
-w /bin/busybox -p x -k MITRE:Execution:T1059.004:Busybox

# --- T1059.006 - Python ---
-w /usr/bin/python -p x -k MITRE:Execution:T1059.006:Python
-w /usr/bin/python2 -p x -k MITRE:Execution:T1059.006:Python2
-w /usr/bin/python3 -p x -k MITRE:Execution:T1059.006:Python3

# --- T1059.001 - PowerShell (if installed) ---
-w /usr/bin/pwsh -p x -k MITRE:Execution:T1059.001:PowerShell
-w /opt/microsoft/powershell/7/pwsh -p x -k MITRE:Execution:T1059.001:PowerShell

# --- T1059.007 - JavaScript ---
-w /usr/bin/node -p x -k MITRE:Execution:T1059.007:Node

# --- T1059.002 - AppleScript (not applicable to Linux) ---

# --- T1059.005 - Visual Basic (not applicable to Linux) ---

# --- Other Interpreters ---
-w /usr/bin/perl -p x -k MITRE:Execution:T1059:Perl
-w /usr/bin/ruby -p x -k MITRE:Execution:T1059:Ruby
-w /usr/bin/lua -p x -k MITRE:Execution:T1059:Lua
-w /usr/bin/php -p x -k MITRE:Execution:T1059:PHP
-w /usr/bin/awk -p x -k MITRE:Execution:T1059:Awk
-w /usr/bin/gawk -p x -k MITRE:Execution:T1059:Gawk
